{
  "name": "penwave-backend",
  "version": "1.0.0",
  "description": "Penwave blogging platform backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:studio": "prisma studio",
    "cron:clean-tokens": "tsx src/scripts/cleanTokens.ts"
  },
  "overrides": {
    "postcss": "8.5.18"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.0",
    "@prisma/client": "5.22.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.2",
    "express-rate-limit": "7.4.1",
    "express-validator": "7.3.2",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1",
    "ms": "2.1.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "4.2.0",
    "sanitize-html": "2.13.1",
    "slugify": "1.6.6",
    "uuid": "11.1.1",
    "winston": "3.15.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/ms": "0.7.34",
    "@types/node": "22.9.0",
    "@types/sanitize-html": "2.13.0",
    "@types/uuid": "10.0.0",
    "prisma": "5.22.0",
    "tsx": "4.22.4",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
